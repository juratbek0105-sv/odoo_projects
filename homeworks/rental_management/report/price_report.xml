<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <template id="price_report">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <div class="page">
                        <div tyle="text-align:center; margin-bottom:15px;">
                            <h2 style="font-weight:700; color:#333;">Rental Price Report</h2>
                            <span style="font-size:20px; color:#777;">Product:
                                <t t-esc="doc.name"/>
                            </span>
                        </div>
                         <t t-foreach="doc.rental_price_ids" t-as="price">
                                <tr>
                                    <td><h2>Details</h2></td> <br/>
                                    <strong>Interval Type</strong> <t t-esc="price.interval_type"/> <br/>
                                    <strong>Interval Number</strong> <t t-esc="price.interval_number"/> <br/>
                                    <strong>Price</strong> <t t-esc="price.price"/> <br/>
                                    <strong>Last Update Date</strong> <t t-esc="price.write_date and price.write_date.strftime('%Y-%m-%d %H:%M') or '—'"/>
                                </tr>
                            </t>

                    </div>
                </t>
            </t>
        </template>

        <record id="action_price_report" model="ir.actions.report">
            <field name="name">Product Price Report</field>
            <field name="model">rental.product</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">rental_management.price_report</field>
            <field name="report_file">rental_management.price_report</field>
            <field name="print_report_name">'Product Price - %s' % object.name</field>
            <field name="binding_model_id" ref="model_rental_product"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>