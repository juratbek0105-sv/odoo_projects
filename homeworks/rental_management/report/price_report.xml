<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data>

        ```
        <!-- Rental Product Price Report Template -->
        <template id="price_report">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <div class="page">

                        <!-- Header -->
                        <div style="text-align:center; margin-bottom:20px;">
                            <h2 style="font-weight:700; color:#2c3e50; margin:0;">Rental Price Report</h2>
                            <span style="font-size:14px; color:#7f8c8d;">
                                Product:
                                <t t-esc="doc.name"/>
                            </span>
                        </div>

                        <!-- Price Table -->
                        <div style="margin-top:15px;">
                            <h4 style="background:#f8f9fa; padding:8px 10px; border-left:4px solid #2980b9; margin-bottom:10px;">
                                Price Details
                            </h4>
                            <table style="width:100%; border:1px solid #ddd; border-collapse:collapse; font-size:13px;">
                                <thead style="background-color:#f1f1f1;">
                                    <tr>
                                        <th style="border:1px solid #ddd; padding:6px;">Interval Type</th>
                                        <th style="border:1px solid #ddd; padding:6px;">Interval Number</th>
                                        <th style="border:1px solid #ddd; padding:6px;">Price</th>
                                        <th style="border:1px solid #ddd; padding:6px;">Last Update Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.rental_price_ids" t-as="price">
                                        <tr>
                                            <td style="border:1px solid #ddd; padding:6px; text-transform:capitalize;">
                                                <t t-esc="price.interval_type"/>
                                            </td>
                                            <td style="border:1px solid #ddd; padding:6px; text-align:center;">
                                                <t t-esc="price.interval_number"/>
                                            </td>
                                            <td style="border:1px solid #ddd; padding:6px; text-align:right;">
                                                <t t-esc="price.price"/>
                                            </td>
                                            <td style="border:1px solid #ddd; padding:6px; text-align:center;">
                                                <t t-esc="price.write_date and price.write_date.strftime('%Y-%m-%d %H:%M') or '—'"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <!-- Footer -->
                        <div style="margin-top:40px; font-size:11px; color:#888; text-align:center;">
                            <span>Generated by Odoo Rental Management System</span>
                            <br/>
                            <span>
                                <t t-esc="time.strftime('%Y-%m-%d %H:%M')"/>
                            </span>
                        </div>

                    </div>
                </t>
            </t>
        </template>

        <!-- Report Action -->
        <record id="action_price_report" model="ir.actions.report">
            <field name="name">Product Price Report</field>
            <field name="model">rental.product</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">rental_management.price_report</field>
            <field name="report_file">rental_management.price_report</field>
            <field name="print_report_name">'Product Price - %s' % (object.name or '')</field>
            <field name="binding_model_id" ref="model_rental_product"/>
            <field name="binding_type">report</field>
        </record>

    </data>
    ```

</odoo>
