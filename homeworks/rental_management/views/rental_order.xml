<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Order List View -->
        <record id="view_order_list" model="ir.ui.view">
            <field name="name">rental.order.list</field>
            <field name="model">rental.order</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="product_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="returned_date"/>
                    <field name="duration"/>
                    <field name="human_readable_duration"/>
                    <field name="total_price"/>
                    <field name="complete_price"/>
                    <field name="status"/>
                </list>
            </field>
        </record>

        <!-- Order Form View -->
        <record id="view_order_form" model="ir.ui.view">
            <field name="name">rental.order.form</field>
            <field name="model">rental.order</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                        <button name="action_return" type="object" string="Return" class="btn-secondary"/>
                        <field name="status" widget="statusbar" statusbar_visible="draft,confirmed,returned"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="customer_id"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="returned_date"/>
                        </group>
                        <group>
                            <field name="duration" readonly="1"/>
                            <field name="human_readable_duration" readonly="1"/>
                            <field name="total_price" readonly="1"/>
                            <field name="complete_price" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_order" model="ir.actions.act_window">
            <field name="name">Orders</field>
            <field name="res_model">rental.order</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menu -->
        <menuitem id="menu_order" parent="menu_root_rental" action="action_order" name="Orders"/>

    </data>
</odoo>
