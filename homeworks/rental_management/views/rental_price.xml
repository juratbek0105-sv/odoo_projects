<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- List View -->
        <record id="view_price_list" model="ir.ui.view">
            <field name="name">rental.price.list</field>
            <field name="model">rental.price</field>
            <field name="arch" type="xml">
                <list>
                    <field name="product_id"/>
                    <field name="interval_number"/>
                    <field name="interval_type"/>
                    <field name="price"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_price_form" model="ir.ui.view">
            <field name="name">rental.price.form</field>
            <field name="model">rental.price</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="product_id"/>
                            <field name="interval_number"/>
                            <field name="interval_type"/>
                            <field name="price"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_price" model="ir.actions.act_window">
            <field name="name">Prices</field>
            <field name="res_model">rental.price</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menu -->
        <menuitem id="menu_price" parent="menu_root_rental" action="action_price" name="Prices"/>

    </data>
</odoo>
