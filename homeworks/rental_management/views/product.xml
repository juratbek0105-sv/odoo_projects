<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_product_list" model="ir.ui.view">
            <field name="name">rental.product.list</field>
            <field name="model">rental.product</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="availability"/>
                    <field name="broken"/>
                    <field name="future_availability_date"/>
                     <field name="avg_rental_hours"/>
                    <field name="active"/>

                </list>
            </field>
        </record>

        <!-- Product Form View -->
        <record id="view_product_form" model="ir.ui.view">
            <field name="name">rental.product.form</field>
            <field name="model">rental.product</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_toggle_broken"
                                type="object"
                                string="Mark as Broken/Fixed"
                                class="btn-primary"/>
                    </header>
                    <sheet>
                        <field name="image_1920" widget="image" class="oe_avatar"
                               options="{'convert_to_webp': True, 'preview_image': 'image_128'}"/>
                        <div class="oe_title">
                            <label for="name" string="Product"/>
                            <h1>
                                <div class="d-flex">
                                    <field class="text-break" name="name" options="{'line_breaks': False}" widget="text"
                                           placeholder="e.g. Car"/>
                                </div>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="availability"/>
                                <field name="category_id"/>
                                <field name="active"/>

                            </group>
                            <group>
                                <field name="broken"/>
                                <field name="future_availability_date"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="product_kanban" model="ir.ui.view">
            <field name="name">rental.product.kanban</field>
            <field name="model">rental.product</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_view">
                    <field name="name"/>
                    <field name="availability"/>
                    <field name="broken"/>
                    <field name="future_availability_date"/>

                    <templates>
                        <t t-name="card">
                            <div class="o_kanban_record card shadow-sm rounded p-3 mb-2"
                                 t-attf-style="border-left:5px solid #{record.broken.value and 'red' or 'green'}">

                                <!-- Product name -->
                                <div class="o_kanban_primary mb-2">
                                    <span class="fw-bold fs-5 text-primary">
                                        <field name="name"/>
                                    </span>
                                </div>

                                <!-- Status section -->
                                <div class="o_kanban_secondary small">
                                    <div class="mb-1">
                                        <i class="fa fa-check-circle text-success me-1"/>
                                        <strong>Available:</strong>
                                        <field name="availability"/>
                                    </div>

                                    <div class="mb-1">
                                        <i class="fa fa-exclamation-triangle text-danger me-1"/>
                                        <strong>Broken:</strong>
                                        <field name="broken"/>
                                    </div>

                                    <div>
                                        <i class="fa fa-calendar text-info me-1"/>
                                        <strong>Future Available:</strong>
                                        <field name="future_availability_date"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>

            </field>
        </record>

        <!-- Action -->
        <record id="action_product" model="ir.actions.act_window">
            <field name="name">Products</field>
            <field name="res_model">rental.product</field>
            <field name="view_mode">kanban,list,form</field>
        </record>

        <!-- Menu -->
        <menuitem id="menu_product" parent="menu_root_rental" action="action_product" name="Products"/>

    </data>
</odoo>
