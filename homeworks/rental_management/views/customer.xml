<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Customer List View -->
        <record id="view_customer_list" model="ir.ui.view">
            <field name="name">rental.customer.list</field>
            <field name="model">rental.customer</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="phone"/>
                    <field name="email"/>
                </list>
            </field>
        </record>

        <!-- Customer Form View -->
        <record id="view_customer_form" model="ir.ui.view">
            <field name="name">rental.customer.form</field>
            <field name="model">rental.customer</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <notebook>
                            <page string="Rental Orders">
                                <field name="rental_orders">
                                    <list>
                                        <field name="name"/>
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                        <field name="complete_price"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_customer" model="ir.actions.act_window">
            <field name="name">Customers</field>
            <field name="res_model">rental.customer</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menu -->
        <menuitem id="menu_customer" parent="menu_root_rental" action="action_customer" name="Customers"/>

    </data>
</odoo>
