<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Customer List View -->
        <record id="view_customer_list" model="ir.ui.view">
            <field name="name">rental.customer.list</field>
            <field name="model">rental.customer</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <field name="active"/>
                    <field name="rental_order_count"/>
                </list>
            </field>
        </record>

        <!-- Customer Form View -->
        <record id="view_customer_form" model="ir.ui.view">
            <field name="name">rental.customer.form</field>
            <field name="model">rental.customer</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="active"/>
                        </group>
                        <notebook>
                            <page string="Rental Orders">
                                <field name="rental_orders">
                                    <list>
                                        <field name="name"/>
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                        <field name="complete_price"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="customer_kanban" model="ir.ui.view">
            <field name="name">rental.customer.kanban</field>
            <field name="model">rental.customer</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_view">
                    <field name="name"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <field name="active"/>

                    <templates>
                        <t t-name="card">
                            <div class="o_kanban_record card shadow-sm rounded p-3 mb-2"
                                 style="border-left: 5px solid #4e73df;">
                                <!-- Name -->
                                <div class="o_kanban_primary mb-2">
                                    <span class="fw-bold fs-5 text-primary">
                                        <field name="name"/>
                                    </span>
                                </div>

                                <!-- Contact info -->
                                <div class="o_kanban_secondary text-muted small">
                                    <div class="mb-1">
                                        <i class="fa fa-phone me-1 text-success"/>
                                        <field name="phone"/>
                                    </div>
                                    <div class="mb-1">
                                        <i class="fa fa-envelope me-1 text-danger"/>
                                        <field name="email"/>
                                    </div>
                                    <div>
                                        <i class="fa fa-toggle-on me-1 text-info"/>
                                        <field name="active"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>

            </field>
        </record>

        <!-- Action -->
        <record id="action_customer" model="ir.actions.act_window">
            <field name="name">Customers</field>
            <field name="res_model">rental.customer</field>
            <field name="view_mode">list,kanban,form</field>
        </record>

        <!-- Menu -->
        <menuitem id="menu_customer" parent="menu_root_rental" action="action_customer" name="Customers"/>

    </data>
</odoo>
