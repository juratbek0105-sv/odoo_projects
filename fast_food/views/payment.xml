<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Payment List View -->
        <record id="payment_list" model="ir.ui.view">
            <field name="name">fast.food.payment.list</field>
            <field name="model">fast.food.payment</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="order_id"/>
                    <field name="amount"/>
                    <field name="payment_method"/>
                    <field name="payment_time" readonly="1"/>
                    <field name="status" readonly="1"/>
                </list>
            </field>
        </record>

        <!-- Payment Form View -->
        <record id="payment_form" model="ir.ui.view">
            <field name="name">fast.food.payment.form</field>
            <field name="model">fast.food.payment</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_cancel_payment" type="object" string="Cancel Payment"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="order_id"/>
                            <field name="amount"/>
                            <field name="payment_method"/>
                            <field name="payment_time" readonly="1"/>
                            <field name="status" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Payment Kanban View -->
        <record id="payment_kanban" model="ir.ui.view">
            <field name="name">fast.food.payment.kanban</field>
            <field name="model">fast.food.payment</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="order_id"/>
                    <field name="amount"/>
                    <field name="payment_method"/>
                    <field name="payment_time"/>
                    <field name="status"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click">
                                <strong>Order: <t t-esc="record.order_id.value"/></strong><br/>
                                Amount: <t t-esc="record.amount.value"/> UZS<br/>
                                Method: <t t-esc="record.payment_method.value"/><br/>
                                Time: <t t-esc="record.payment_time.value"/><br/>
                                Status: <span t-esc="record.status.value"
                                              t-attf-class="badge #{'text-success' if record.status.value=='paid' else 'text-warning' if record.status.value=='partial' else 'text-secondary'}"/>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
    </data>
</odoo>
