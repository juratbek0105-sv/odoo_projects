<odoo>
    <data>
        <!-- Category List View -->
        <record id="category_list" model="ir.ui.view">
            <field name="name">fast.food.category.list</field>
            <field name="model">fast.food.category</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="sequence"/>
                </list>
            </field>
        </record>

        <!-- Category Form View -->
        <record id="category_form" model="ir.ui.view">
            <field name="name">fast.food.category.form</field>
            <field name="model">fast.food.category</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <notebook>
                            <page string="Products in this Category">
                                <field name="product_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="price"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
