<odoo>
    <!-- Form View -->
    <record id="view_kitchen_display_form" model="ir.ui.view">
        <field name="name">fast.food.kitchen.display.form</field>
        <field name="model">fast.food.kitchen.display</field>
        <field name="arch" type="xml">
            <form string="New Kitchen Order">
                <group>
                    <field name="order_type"/>
                    <field name="table_number"/>
                </group>

                <separator string="Select Products"/>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="product_id"/>
                        <field name="quantity"/>
                    </list>
                </field>

                <footer>
                    <button name="action_confirm_order" type="object"
                            string="Confirm Order" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_kitchen_display_new" model="ir.actions.act_window">
        <field name="name">New Kitchen Order</field>
        <field name="res_model">fast.food.kitchen.display</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_kitchen_display_form"/>
        <field name="target">new</field>
    </record>
</odoo>
