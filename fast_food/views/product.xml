<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Product List View -->
        <record id="product_list" model="ir.ui.view">
            <field name="name">fast.food.product.list</field>
            <field name="model">fast.food.product</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="category_id"/>
                    <field name="price"/>
                </list>
            </field>
        </record>

        <!-- Product Form View -->
        <record id="product_form" model="ir.ui.view">
            <field name="name">fast.food.product.form</field>
            <field name="model">fast.food.product</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <field name="image" widget="image" class="oe_avatar"/>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="category_id"/>
                            <field name="price"/>
                        </group>
                        <notebook>
                            <page string="Order Lines">
                                <field name="order_line_ids">
                                    <list>
                                        <field name="order_id"/>
                                        <field name="product_id"/>
                                        <field name="subtotal"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Product Kanban View -->
        <record id="product_kanban" model="ir.ui.view">
            <field name="name">fast.food.product.kanban</field>
            <field name="model">fast.food.product</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_small_column">
                    <field name="name"/>
                    <field name="image"/>
                    <field name="price"/>
                    <templates>
                        <t t-name="card">
                            <div style="display: flex; align-items: center; gap: 12px; padding: 8px; border: 1px solid #e2e2e2; border-radius: 8px; background-color: #fff;">

                                <!-- Product Image -->
                                <div style="width: 80px; height: 80px; flex-shrink: 0; overflow: hidden; display: flex; justify-content: center; align-items: center;">
                                    <field name="image" widget="image" alt="Product"
                                           options="{'img_class': 'w-full h-full object-contain'}"
                                           invisible="not image"/>
                                </div>

                                <!-- Product Details -->
                                <div style="display: flex; flex-direction: column; justify-content: center;">
                                    <strong style="font-size: 16px; color: #333;">
                                        <t t-esc="record.name.value"/>
                                    </strong>
                                    <span style="color: #666; margin-top: 4px;">
                                        <t t-esc="record.price.value"/>
                                        UZS
                                    </span>
                                </div>

                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="product_search" model="ir.ui.view">
            <field name="name">fast.food.product.search</field>
            <field name="model">fast.food.product</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>

                    <group>
                        <field name="category_id"/>
                    </group>
                </search>
            </field>
        </record>
    </data>
</odoo>
