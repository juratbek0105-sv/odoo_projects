<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_product" model="ir.actions.act_window">
            <field name="name">Products</field>
            <field name="res_model">fast.food.product</field>
            <field name="view_mode">kanban,list,form</field>
        </record>

        <record id="action_category" model="ir.actions.act_window">
            <field name="name">Categories</field>
            <field name="res_model">fast.food.category</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_order" model="ir.actions.act_window">
            <field name="name">Orders</field>
            <field name="res_model">fast.food.order</field>
            <field name="view_mode">kanban,list,form</field>
        </record>

        <record id="action_order_line" model="ir.actions.act_window">
            <field name="name">Order Lines</field>
            <field name="res_model">fast.food.order.line</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_payment" model="ir.actions.act_window">
            <field name="name">Payment</field>
            <field name="res_model">fast.food.payment</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_active_orders" model="ir.actions.act_window">
            <field name="name">Active Orders</field>
            <field name="res_model">fast.food.order</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('status', 'in', ('draft', 'confirmed'))]</field>
        </record>
    </data>
</odoo>

