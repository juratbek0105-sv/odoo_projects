<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data>
        <!-- PRODUCT REPORT TEMPLATE -->
        <template id="report_fast_food_product">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <div class="page" style="font-family:'Arial', sans-serif;">

                        <!-- HEADER -->
                        <div style="text-align:center; margin-bottom:20px;">
                            <h1 style="font-weight:700; color:#2c3e50; text-transform:uppercase; letter-spacing:1px;">
                                Fast Food Product Report
                            </h1>
                            <div style="font-size:15px; color:#7f8c8d; margin-top:5px;">
                                <strong>Product Name:</strong>
                                <t t-esc="doc.name"/>
                            </div>
                        </div>

                        <!-- IMAGE -->
                        <t t-if="doc.image">
                            <div style="text-align:center; margin-bottom:20px;">
                                <img t-att-src="'data:image/png;base64,%s' % doc.image"
                                     style="width:150px; height:150px; object-fit:cover; border-radius:12px; border:2px solid #ecf0f1; box-shadow:0 2px 6px rgba(0,0,0,0.15);"/>
                            </div>
                        </t>

                        <!-- PRODUCT DETAILS -->
                        <table style="width:100%; border-collapse:collapse; font-size:14px; margin-bottom:20px;">
                            <tr style="background-color:#f9f9f9;">
                                <td style="padding:10px; border:1px solid #ddd;">
                                    <strong>Category</strong>
                                </td>
                                <td style="padding:10px; border:1px solid #ddd;">
                                    <t t-esc="doc.category_id.name or '-'"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:10px; border:1px solid #ddd;">
                                    <strong>Price</strong>
                                </td>
                                <td style="padding:10px; border:1px solid #ddd;">
                                    <t t-esc="doc.price"/>
                                    <t t-esc="doc.currency_id.symbol or 'UZS'"/>
                                </td>
                            </tr>
                            <tr style="background-color:#f9f9f9;">
                                <td style="padding:10px; border:1px solid #ddd;">
                                    <strong>Description</strong>
                                </td>
                                <td style="padding:10px; border:1px solid #ddd;">
                                    <t t-esc="doc.description or '-'"/>
                                </td>
                            </tr>
                        </table>

                        <!-- ORDER HISTORY SECTION -->
                        <div>
                            <h3 style="background-color:#34495e; color:white; padding:8px 10px; border-radius:4px; text-align:center;">
                                Order History
                            </h3>

                            <table class="table table-sm"
                                   style="width:100%; border:1px solid #ccc; border-collapse:collapse; font-size:13px;">
                                <thead style="background-color:#ecf0f1;">
                                    <tr>
                                        <th style="border:1px solid #ccc; padding:8px;">Order</th>
                                        <th style="border:1px solid #ccc; padding:8px;">Quantity</th>
                                        <th style="border:1px solid #ccc; padding:8px;">Price</th>
                                        <th style="border:1px solid #ccc; padding:8px;">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="doc.order_line_ids">
                                        <t t-foreach="doc.order_line_ids" t-as="line">
                                            <tr>
                                                <td style="border:1px solid #ddd; padding:8px;">
                                                    <t t-esc="line.order_id.name or '-'"/>
                                                </td>
                                                <td style="border:1px solid #ddd; padding:8px;">
                                                    <t t-esc="line.quantity"/>
                                                </td>
                                                <td style="border:1px solid #ddd; padding:8px;">
                                                    <t t-esc="line.price_unit"/>
                                                </td>
                                                <td style="border:1px solid #ddd; padding:8px;">
                                                    <t t-esc="line.subtotal or line.quantity * line.price_unit"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <tr>
                                            <td colspan="4" style="text-align:center; padding:10px; color:#7f8c8d;">
                                                No orders found for this product.
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <!-- FOOTER -->
                        <div style="margin-top:25px; text-align:center; font-size:12px; color:#95a5a6;">
                            Report generated by Fast Food Management System
                        </div>

                    </div>
                </t>
            </t>
        </template>

        <!-- REPORT ACTION -->
        <record id="action_fast_food_product_report" model="ir.actions.report">
            <field name="name">Product Report</field>
            <field name="model">fast.food.product</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">fast_food.report_fast_food_product</field>
            <field name="report_file">fast_food.report_fast_food_product</field>
            <field name="print_report_name">'Product - %s' % (object.name)</field>
            <field name="binding_model_id" ref="model_fast_food_product"/>
            <field name="binding_type">report</field>
        </record>

    </data>

</odoo>
