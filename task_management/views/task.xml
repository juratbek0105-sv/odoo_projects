<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record model="ir.ui.view" id="task_list">
            <field name="name">task_management list</field>
            <field name="model">task_management.task</field>
            <field name="arch" type="xml">
                <list>
                    <field name="project_id"/>
                    <field name="name"/>
                    <field name="assignee_id"/>
                    <field name="status"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="task_form">
            <field name="name">task_management form</field>
            <field name="model">task_management.task</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <field name="project_id"/>
                        <field name="name"/>
                        <field name="assignee_id"/>
                        <field name="status"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="task_kanban">
            <field name="name">task_management kanban</field>
            <field name="model">task_management.task</field>
            <field name="arch" type="xml">
                <kanban default_group_by="status">
                    <field name="project_id"/>
                    <field name="name"/>
                    <field name="assignee_id"/>
                    <field name="status"/>
                    <templates>
                        <t t-name="card">
                            <field name="project_id"/>
                            <field name="name"/>
                            <field name="assignee_id"/>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>


        <record model="ir.actions.act_window" id="action_task">
            <field name="name">Tasks</field>
            <field name="res_model">task_management.task</field>
            <field name="view_mode">list,form,kanban</field>
        </record>


    </data>
</odoo>
