<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="project_list">
            <field name="name">task_project list</field>
            <field name="model">task_management.project</field>
            <field name="arch" type="xml">
                <list>
                    <field name="task_ids"/>
                    <field name="name"/>
                    <field name="responsible_id"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="project_form">
            <field name="name">task_project form</field>
            <field name="model">task_management.project</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <field name="task_ids"/>
                        <field name="name"/>
                        <field name="responsible_id"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_project">
            <field name="name">Projects</field>
            <field name="res_model">task_management.project</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
